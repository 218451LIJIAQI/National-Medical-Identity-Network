{
  "name": "medlink-backend",
  "version": "1.0.0",
  "description": "Backend API and federated query hub for MedLink MY National Medical Identity Network",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --schema=prisma/schema.central.prisma && prisma generate --schema=prisma/schema.hospital.prisma",
    "db:push": "prisma db push --schema=prisma/schema.central.prisma --accept-data-loss && tsx scripts/push-hospital-schemas.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:reset": "npm run db:push && npm run db:seed",
    "render:build": "npm run db:generate && npm run db:push && npm run build",
    "render:start": "npm run db:seed && npm start"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
